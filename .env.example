DATABASE_URL=postgresql://root@localhost:26257/memoe?sslmode=disable
OBSERVATION_PROVIDER=ollama

# DO NOT COMMIT API keys.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Bedrock uses your AWS CLI/profile credentials. Do not put AWS secrets here.
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=256
BEDROCK_EMBEDDING_NORMALIZE=true
